import { Button, ComboBox, Palette, ScrollView, Switch } from "std-widgets.slint";

component QuotaRow inherits Rectangle {
    in property <string> label;
    in property <string> remaining;
    in property <string> reset;
    in property <float> value;
    in property <bool> available;
    in property <int> theme-kind;
    background: transparent;
    height: 26px;
    Text { x: 0px; y: 0px; width: 52px; height: 20px; text: root.label; color: root.theme-kind == 2 ? #66717e : #b5b5b5; font-size: 10px; vertical-alignment: center; }
    Rectangle {
        x: 56px; y: 7px; width: 102px; height: 7px; border-radius: 4px;
        background: root.theme-kind == 2 ? #e0e5ea : (root.theme-kind == 0 ? #3a3a3a : #293440);
        Rectangle {
            x: 0px; y: 0px;
            width: root.available ? parent.width * min(100, max(0, root.value)) / 100 : 0px;
            height: parent.height; border-radius: 4px;
            background: {
                if (!root.available) { root.theme-kind == 2 ? #aab3bc : #46515d }
                else if (root.value < 25) { #e35c65 }
                else if (root.value < 50) { #dca743 }
                else { #51ae7c }
            }
        }
    }
    Text { x: 164px; y: 0px; width: 44px; height: 20px; text: root.remaining; color: root.theme-kind == 2 ? #202a35 : #eff3f7; font-size: 12px; font-weight: 650; horizontal-alignment: right; vertical-alignment: center; }
    Text { x: 214px; y: 0px; width: 122px; height: 20px; text: root.reset; color: root.theme-kind == 2 ? #66717e : #8794a3; font-size: 9px; horizontal-alignment: right; vertical-alignment: center; }
}

component ProviderSection inherits Rectangle {
    in property <string> provider-name;
    in property <string> five-label;
    in property <string> weekly-label;
    in property <string> plan-label;
    in property <string> state-label;
    in property <color> state-color;
    in property <string> five-remaining;
    in property <string> five-reset;
    in property <float> five-value;
    in property <bool> five-available;
    in property <string> weekly-remaining;
    in property <string> weekly-reset;
    in property <float> weekly-value;
    in property <bool> weekly-available;
    in property <int> theme-kind;
    in property <image> icon;
    in property <bool> icon-available;
    background: transparent;
    height: 78px;
    Image { x: 0px; y: 2px; width: 18px; height: 18px; source: root.icon; image-fit: contain; visible: root.icon-available; }
    Text { x: 24px; y: 0px; width: 82px; height: 22px; text: root.provider-name; color: root.theme-kind == 2 ? #1b2631 : #f1f1f1; font-size: 13px; font-weight: 650; vertical-alignment: center; }
    Text { x: 88px; y: 1px; width: 170px; height: 20px; text: root.state-label; color: root.state-color; font-size: 9px; vertical-alignment: center; overflow: elide; }
    Rectangle { x: 260px; y: 1px; width: 76px; height: 20px; border-radius: 8px; background: root.theme-kind == 2 ? #eef1f5 : (root.theme-kind == 0 ? #383838 : #243140); visible: root.plan-label != ""; }
    Text { x: 264px; y: 1px; width: 72px; height: 20px; text: root.plan-label; color: root.theme-kind == 2 ? #65717d : #b5b5b5; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
    QuotaRow { x: 0px; y: 25px; width: 336px; label: root.five-label; remaining: root.five-remaining; reset: root.five-reset; value: root.five-value; available: root.five-available; theme-kind: root.theme-kind; }
    QuotaRow { x: 0px; y: 51px; width: 336px; label: root.weekly-label; remaining: root.weekly-remaining; reset: root.weekly-reset; value: root.weekly-value; available: root.weekly-available; theme-kind: root.theme-kind; }
}

export component MainWindow inherits Window {
    in property <bool> demo-mode: false;
    in property <int> theme-kind: 1;
    in property <color> accent-color: #0078d4;
    in property <image> codex-icon;
    in property <bool> codex-icon-available: false;
    in property <image> claude-icon;
    in property <bool> claude-icon-available: false;
    in property <bool> codex-enabled: true;
    in property <bool> claude-enabled: true;
    in property <string> codex-plan: "";
    in property <string> codex-status: "";
    in property <color> codex-status-color: #98a3af;
    in property <string> codex-five-remaining: "—";
    in property <string> codex-five-reset: "";
    in property <float> codex-five-value: 0;
    in property <bool> codex-five-available: false;
    in property <string> codex-weekly-remaining: "—";
    in property <string> codex-weekly-reset: "";
    in property <float> codex-weekly-value: 0;
    in property <bool> codex-weekly-available: false;
    in property <string> claude-plan: "";
    in property <string> claude-status: "";
    in property <color> claude-status-color: #98a3af;
    in property <string> claude-five-remaining: "—";
    in property <string> claude-five-reset: "";
    in property <float> claude-five-value: 0;
    in property <bool> claude-five-available: false;
    in property <string> claude-weekly-remaining: "—";
    in property <string> claude-weekly-reset: "";
    in property <float> claude-weekly-value: 0;
    in property <bool> claude-weekly-available: false;
    in property <string> five-label: "";
    in property <string> weekly-label: "";
    in property <string> demo-label: "";
    in property <string> settings-label: "";
    in property <string> disabled-label: "";
    in property <string> usage-title-label: "";
    in property <string> refresh-label: "";
    in property <bool> refresh-enabled: false;
    callback open-settings();
    callback refresh-requested();

    title: "Agent Usage Monitor";
    width: 370px;
    height: (codex-enabled && claude-enabled) ? 208px : ((codex-enabled || claude-enabled) ? 118px : 78px);
    no-frame: true;
    background: transparent;
    default-font-family: "Segoe UI";
    default-font-size: 12px;
    public function apply-theme-palette() {
        Palette.color-scheme = root.theme-kind == 2 ? ColorScheme.light : ColorScheme.dark;
    }

    property <color> page-background: root.theme-kind == 2 ? #f8fafc : (root.theme-kind == 0 ? #202020 : #111923);
    property <color> page-border: root.theme-kind == 2 ? #cbd2da : (root.theme-kind == 0 ? #414141 : #2b3541);
    property <color> primary-text: root.theme-kind == 2 ? #202a35 : #f1f1f1;
    property <color> secondary-text: root.theme-kind == 2 ? #4e5a66 : #b5b5b5;
    property <color> card-background: root.theme-kind == 2 ? #ffffff : (root.theme-kind == 0 ? #2b2b2b : #19232f);
    property <color> card-border: root.theme-kind == 2 ? #d9dfe5 : (root.theme-kind == 0 ? #414141 : #293440);

    Rectangle {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        background: root.page-background;
        border-color: root.page-border;
        border-width: 1px; border-radius: 14px;
    }
    Text { x: 16px; y: 6px; width: 148px; height: 22px; text: root.usage-title-label; color: root.primary-text; font-size: 13px; font-weight: 650; vertical-alignment: center; }
    Button { x: 170px; y: 5px; width: 44px; height: 24px; text: "↻"; enabled: root.refresh-enabled; accessible-label: root.refresh-label; clicked => { root.refresh-requested(); } }
    Button { x: 216px; y: 5px; width: 88px; height: 24px; text: root.settings-label; clicked => { root.open-settings(); } }
    Button { x: parent.width - 34px; y: 5px; width: 22px; height: 24px; text: "×"; clicked => { root.close(); } }
    if root.demo-mode: Text { x: 16px; y: 190px; width: 230px; height: 12px; text: root.demo-label; color: #bc8128; font-size: 9px; vertical-alignment: center; }

    Rectangle { x: 12px; y: 28px; width: parent.width - 24px; height: 78px; border-radius: 10px; background: root.card-background; border-color: root.card-border; border-width: 1px; visible: root.codex-enabled; }
    Rectangle { x: 12px; y: 112px; width: parent.width - 24px; height: 78px; border-radius: 10px; background: root.card-background; border-color: root.card-border; border-width: 1px; visible: root.claude-enabled; }

    ProviderSection {
        x: 20px; y: 29px; width: 330px; visible: root.codex-enabled;
        provider-name: "Codex"; icon: root.codex-icon; icon-available: root.codex-icon-available; plan-label: root.codex-plan; state-label: root.codex-status; state-color: root.codex-status-color;
        five-label: root.five-label; weekly-label: root.weekly-label;
        five-remaining: root.codex-five-remaining; five-reset: root.codex-five-reset; five-value: root.codex-five-value; five-available: root.codex-five-available;
        weekly-remaining: root.codex-weekly-remaining; weekly-reset: root.codex-weekly-reset; weekly-value: root.codex-weekly-value; weekly-available: root.codex-weekly-available;
        theme-kind: root.theme-kind;
    }
    ProviderSection {
        x: 20px; y: root.codex-enabled ? 113px : 29px; width: 330px; visible: root.claude-enabled;
        provider-name: "Claude"; icon: root.claude-icon; icon-available: root.claude-icon-available; plan-label: root.claude-plan; state-label: root.claude-status; state-color: root.claude-status-color;
        five-label: root.five-label; weekly-label: root.weekly-label;
        five-remaining: root.claude-five-remaining; five-reset: root.claude-five-reset; five-value: root.claude-five-value; five-available: root.claude-five-available;
        weekly-remaining: root.claude-weekly-remaining; weekly-reset: root.claude-weekly-reset; weekly-value: root.claude-weekly-value; weekly-available: root.claude-weekly-available;
        theme-kind: root.theme-kind;
    }
    if !root.codex-enabled && !root.claude-enabled: Text { x: 16px; y: 36px; width: parent.width - 32px; height: 24px; text: root.disabled-label; color: root.secondary-text; horizontal-alignment: center; vertical-alignment: center; }
}

export component SettingsWindow inherits Window {
    in property <int> theme-kind: 1;
    in property <color> accent-color: #0078d4;
    in property <image> codex-icon;
    in property <bool> codex-icon-available: false;
    in property <image> claude-icon;
    in property <bool> claude-icon-available: false;
    in-out property <int> selected-tab: 0;
    in property <bool> codex-enabled: true;
    in property <bool> claude-enabled: true;
    in property <bool> claude-cli-refresh-enabled: false;
    in property <bool> alerts-enabled: true;
    in property <bool> exhausted-alerts-enabled: true;
    in property <bool> include-weekly: true;
    in-out property <int> theme-index: 0;
    in-out property <int> language-index: 0;
    in-out property <int> warning-index: 0;
    in-out property <int> critical-index: 1;
    in-out property <int> duration-index: 1;
    in property <[string]> theme-options: [];
    in property <[string]> language-options: [];
    in property <[string]> warning-options: ["25%", "30%", "40%", "50%", "75%", "100%"];
    in property <[string]> critical-options: ["5%", "10%", "15%", "20%"];
    in property <[string]> duration-options: [];
    in property <string> title-label: "";
    in property <string> general-label: "";
    in property <string> notifications-label: "";
    in property <string> about-label: "";
    in property <string> appearance-label: "";
    in property <string> providers-label: "";
    in property <string> theme-name-label: "";
    in property <string> language-name-label: "";
    in property <string> codex-description: "";
    in property <string> claude-description: "";
    in property <string> codex-state: "";
    in property <string> claude-state: "";
    in property <string> alerts-description: "";
    in property <string> claude-refresh-label: "";
    in property <string> claude-refresh-description: "";
    in property <string> warning-name-label: "";
    in property <string> critical-name-label: "";
    in property <string> exhausted-name-label: "";
    in property <string> weekly-name-label: "";
    in property <string> duration-name-label: "";
    in property <string> about-product: "AgentUsageMonitor";
    in property <string> about-tagline: "";
    in property <string> about-version: "";
    in property <string> about-author: "";
    in property <string> about-repository: "";
    in property <string> about-license: "";
    in property <string> about-technologies: "";
    in property <string> source-note: "";
    callback select-tab(int);
    callback theme-selected(string);
    callback language-selected(string);
    callback warning-selected(string);
    callback critical-selected(string);
    callback duration-selected(string);
    callback toggle-alerts();
    callback toggle-exhausted-alerts();
    callback toggle-weekly();
    callback toggle-codex();
    callback toggle-claude();
    callback toggle-claude-cli-refresh();
    callback open-repository();
    callback close-settings();

    title: "AgentUsageMonitor — " + root.title-label;
    preferred-width: 720px;
    preferred-height: 600px;
    min-width: 680px;
    min-height: 560px;
    default-font-family: "Segoe UI";
    default-font-size: 13px;
    public function apply-theme-palette() {
        Palette.color-scheme = root.theme-kind == 2 ? ColorScheme.light : ColorScheme.dark;
    }
    property <color> page-background: root.theme-kind == 2 ? #f3f6fa : (root.theme-kind == 0 ? #202020 : #10161f);
    property <color> sidebar-background: root.theme-kind == 2 ? #edf1f6 : (root.theme-kind == 0 ? #191919 : #151d28);
    property <color> card-background: root.theme-kind == 2 ? #ffffff : (root.theme-kind == 0 ? #2b2b2b : #19232f);
    property <color> border-color-value: root.theme-kind == 2 ? #dce3eb : (root.theme-kind == 0 ? #414141 : #2a3746);
    property <color> primary-text: root.theme-kind == 2 ? #202c39 : #f1f1f1;
    property <color> secondary-text: root.theme-kind == 2 ? #344252 : #d0d0d0;
    property <color> muted-text: root.theme-kind == 2 ? #5d6976 : #b5b5b5;
    property <color> subtle-text: root.theme-kind == 2 ? #687584 : #a8a8a8;
    background: root.page-background;

    Rectangle {
        x: 0px; y: 0px; width: parent.width; height: parent.height;
        background: root.page-background;
    }
    Rectangle {
        x: 0px; y: 0px; width: 200px; height: parent.height;
        background: root.sidebar-background;
    }
    Text {
        x: 20px; y: 24px; width: 172px; height: 48px;
        text: "AgentUsageMonitor"; font-size: 15px; font-weight: 700;
        color: root.theme-kind == 2 ? #1b2633 : #f1f1f1;
        vertical-alignment: center;
    }
    Text {
        x: 20px; y: 68px; width: 172px; height: 34px;
        text: root.title-label; font-size: 12px;
        color: root.theme-kind == 2 ? #5e6a78 : #9aa8b7;
        vertical-alignment: center; wrap: word-wrap;
    }
    for tab[index] in [root.general-label, root.notifications-label, root.about-label] : Rectangle {
        x: 12px; y: 128px + index * 48px; width: 176px; height: 40px; background: transparent;
        Rectangle { x: 0px; y: 7px; width: 3px; height: 26px; border-radius: 2px; background: root.accent-color; visible: root.selected-tab == index; }
        Button {
            x: 4px; y: 0px; width: 172px; height: 40px; text: tab;
            checkable: false; checked: root.selected-tab == index;
            clicked => { root.select-tab(index); }
        }
        if index == 0 : Rectangle { x: 17px; y: 12px; width: 15px; height: 2px; border-radius: 1px; background: root.theme-kind == 2 ? #596572 : #c7c7c7; }
        if index == 0 : Rectangle { x: 17px; y: 18px; width: 15px; height: 2px; border-radius: 1px; background: root.theme-kind == 2 ? #596572 : #c7c7c7; }
        if index == 0 : Rectangle { x: 17px; y: 24px; width: 15px; height: 2px; border-radius: 1px; background: root.theme-kind == 2 ? #596572 : #c7c7c7; }
        if index == 1 : Rectangle { x: 20px; y: 12px; width: 10px; height: 12px; border-radius: 4px; background: root.theme-kind == 2 ? #596572 : #c7c7c7; }
        if index == 1 : Rectangle { x: 22px; y: 25px; width: 6px; height: 3px; border-radius: 2px; background: root.theme-kind == 2 ? #596572 : #c7c7c7; }
        if index == 2 : Rectangle { x: 17px; y: 12px; width: 16px; height: 16px; border-radius: 8px; border-color: root.theme-kind == 2 ? #596572 : #c7c7c7; border-width: 1px; background: transparent; }
        if index == 2 : Text { x: 17px; y: 12px; width: 16px; height: 16px; text: "i"; font-weight: 700; color: root.theme-kind == 2 ? #596572 : #c7c7c7; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle { x: 200px; y: 0px; width: 1px; height: parent.height; background: root.border-color-value; }

    if root.selected-tab == 0 : ScrollView {
        x: 224px; y: 24px; width: parent.width - 248px; height: parent.height - 48px;
        VerticalLayout {
            width: parent.width;
            spacing: 8px;
            alignment: start;
            Text { text: root.general-label; font-size: 24px; font-weight: 650; color: root.theme-kind == 2 ? #1b2633 : #f1f4f8; }
            Text { text: root.appearance-label; font-size: 14px; font-weight: 650; color: root.theme-kind == 2 ? #344252 : #cad3de; }
            VerticalLayout {
                width: parent.width; spacing: 4px; alignment: start;
                HorizontalLayout {
                    height: 36px;
                    Text { text: root.theme-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; }
                    ComboBox { width: 180px; model: root.theme-options; current-index <=> root.theme-index; selected(value) => { root.theme-selected(value); } }
                }
                HorizontalLayout {
                    height: 36px;
                    Text { text: root.language-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; }
                    ComboBox { width: 180px; model: root.language-options; current-index <=> root.language-index; selected(value) => { root.language-selected(value); } }
                }
            }
            Text { text: root.providers-label; font-size: 14px; font-weight: 650; color: root.theme-kind == 2 ? #344252 : #cad3de; }
            Rectangle {
                width: parent.width; height: 76px; border-radius: 8px;
                background: root.card-background;
                border-color: root.border-color-value; border-width: 1px;
                Rectangle { x: 16px; y: 14px; width: 24px; height: 24px; border-radius: 6px; background: root.theme-kind == 2 ? #f2f4f7 : (root.theme-kind == 0 ? #383838 : #243140); visible: root.codex-icon-available; }
                Image { x: 20px; y: 18px; width: 16px; height: 16px; source: root.codex-icon; image-fit: contain; visible: root.codex-icon-available; }
                Text { x: 48px; y: 14px; width: 125px; height: 24px; text: "Codex"; font-weight: 650; color: root.primary-text; vertical-alignment: center; }
                Text { x: 16px; y: 40px; width: parent.width - 92px; height: 28px; text: root.codex-state + " · " + root.codex-description; color: root.muted-text; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
                Switch { x: parent.width - 70px; y: 16px; checked: root.codex-enabled; toggled => { root.toggle-codex(); } }
            }
            Rectangle {
                width: parent.width; height: 134px; border-radius: 8px;
                background: root.card-background;
                border-color: root.border-color-value; border-width: 1px;
                Rectangle { x: 16px; y: 14px; width: 24px; height: 24px; border-radius: 6px; background: root.theme-kind == 2 ? #f2f4f7 : (root.theme-kind == 0 ? #383838 : #243140); visible: root.claude-icon-available; }
                Image { x: 20px; y: 18px; width: 16px; height: 16px; source: root.claude-icon; image-fit: contain; visible: root.claude-icon-available; }
                Text { x: 48px; y: 14px; width: 125px; height: 24px; text: "Claude"; font-weight: 650; color: root.primary-text; vertical-alignment: center; }
                Text { x: 16px; y: 40px; width: parent.width - 92px; height: 34px; text: root.claude-state + " · " + root.claude-description; color: root.muted-text; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
                Switch { x: parent.width - 70px; y: 16px; checked: root.claude-enabled; toggled => { root.toggle-claude(); } }
                Text { x: 16px; y: 80px; width: parent.width - 92px; height: 22px; text: root.claude-refresh-label; color: root.muted-text; font-size: 11px; vertical-alignment: center; }
                Switch { x: parent.width - 70px; y: 78px; checked: root.claude-cli-refresh-enabled; toggled => { root.toggle-claude-cli-refresh(); } }
                Text { x: 16px; y: 104px; width: parent.width - 32px; height: 24px; text: root.claude-refresh-description; color: root.theme-kind == 2 ? #687584 : #8998a8; font-size: 10px; vertical-alignment: center; wrap: word-wrap; }
            }
            Text { text: root.source-note; color: root.theme-kind == 2 ? #687584 : #8998a8; font-size: 11px; wrap: word-wrap; vertical-stretch: 0; }
        }
    }
    if root.selected-tab == 1 : ScrollView {
        x: 224px; y: 24px; width: parent.width - 248px; height: parent.height - 48px;
        VerticalLayout {
            width: parent.width; spacing: 8px; alignment: start;
            Text { text: root.notifications-label; font-size: 24px; font-weight: 650; color: root.theme-kind == 2 ? #1b2633 : #f1f4f8; }
            Rectangle {
                width: parent.width; height: 76px; border-radius: 8px;
                background: root.card-background;
                border-color: root.border-color-value; border-width: 1px;
                Text { x: 16px; y: 12px; width: parent.width - 90px; height: 24px; text: root.notifications-label; font-weight: 650; color: root.theme-kind == 2 ? #202c39 : #edf2f7; vertical-alignment: center; }
                Text { x: 16px; y: 38px; width: parent.width - 90px; height: 24px; text: root.alerts-description; color: root.theme-kind == 2 ? #687584 : #9eacbb; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
                Switch { x: parent.width - 70px; y: 26px; checked: root.alerts-enabled; toggled => { root.toggle-alerts(); } }
            }
            Rectangle {
                width: parent.width; height: 240px; border-radius: 8px;
                background: root.card-background;
                border-color: root.border-color-value; border-width: 1px;
                VerticalLayout {
                    x: 16px; y: 8px; width: parent.width - 32px; spacing: 5px;
                    HorizontalLayout {
                        height: 42px;
                        Text { text: root.warning-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        ComboBox { width: 104px; model: root.warning-options; current-index <=> root.warning-index; selected(value) => { root.warning-selected(value); } }
                    }
                    HorizontalLayout {
                        height: 42px;
                        Text { text: root.critical-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        ComboBox { width: 104px; model: root.critical-options; current-index <=> root.critical-index; selected(value) => { root.critical-selected(value); } }
                    }
                    HorizontalLayout {
                        height: 38px;
                        Text { text: root.exhausted-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        Switch { checked: root.exhausted-alerts-enabled; toggled => { root.toggle-exhausted-alerts(); } }
                    }
                    HorizontalLayout {
                        height: 38px;
                        Text { text: root.weekly-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; wrap: word-wrap; }
                        Switch { checked: root.include-weekly; toggled => { root.toggle-weekly(); } }
                    }
                    HorizontalLayout {
                        height: 38px;
                        Text { text: root.duration-name-label; color: root.theme-kind == 2 ? #344252 : #dbe2eb; vertical-alignment: center; horizontal-stretch: 1; }
                        ComboBox { width: 104px; model: root.duration-options; current-index <=> root.duration-index; selected(value) => { root.duration-selected(value); } }
                    }
                }
            }
        }
    }
    if root.selected-tab == 2 : VerticalLayout {
        x: 224px; y: 24px; width: parent.width - 248px; height: parent.height - 48px; spacing: 10px; alignment: start;
        Text { text: root.about-product; font-size: 24px; font-weight: 650; color: root.theme-kind == 2 ? #1b2633 : #f1f4f8; }
        Rectangle {
            width: parent.width; height: 230px; border-radius: 10px;
            background: root.card-background;
            border-color: root.border-color-value; border-width: 1px;
            VerticalLayout {
                x: 20px; y: 18px; width: parent.width - 40px; spacing: 12px; alignment: start;
                Text { text: root.about-tagline; color: root.theme-kind == 2 ? #657281 : #a1afbe; wrap: word-wrap; }
                Text { text: root.about-version; color: root.theme-kind == 2 ? #344252 : #dbe2eb; }
                Text { text: root.about-author; color: root.theme-kind == 2 ? #344252 : #dbe2eb; }
                Button { text: root.about-repository; primary: false; clicked => { root.open-repository(); } }
                Text { text: root.about-license; color: root.theme-kind == 2 ? #687584 : #9eacbb; font-size: 11px; wrap: word-wrap; }
                Text { text: root.about-technologies; color: root.theme-kind == 2 ? #687584 : #9eacbb; font-size: 11px; wrap: word-wrap; }
            }
        }
    }
}
